# Copy this file to .env and fill in the keys. .env is git-ignored and never baked into the Docker image.
# Both are optional and free. Without them those two checks are skipped.

# setlist.fm concert history. Get a key at https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=ru_ab9KEuccXJLSH-5vp6aPz2jqggYtfOKRA

# YouTube Data API v3 (live-performance videos). Create an API key in https://console.cloud.google.com
YOUTUBE_API_KEY=AIzaSyBAFNEwdioe7tSIho-X8cCUZEpLlrvF56A

# --- AI query layer (optional) -------------------------------------------------
# When the plain search can't make sense of a query ("justin johnston guitar", a misspelling, a Greek spelling), Claude
# splits it into name, clues and alternate spellings. It is only a last resort and every answer is cached for a month.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for the query layer. Defaults to claude-opus-5-5. claude-haiku-5-5 is roughly 40x cheaper and plenty for this task.
AI_MODEL=
# Maximum AI calls per UTC day, so a public site cannot run up the bill (default 300)
AI_DAILY_LIMIT=
